{
    "name": "carly-electron",
    "version": "0.0.1",
    "main": "main.js",
    "description": "Carly Car Manager",
    "author": "Carly Team",
    "scripts": {
        "start": "npx electron .",
        "dev": "npx electron .",
        "electron": "electron .",
        "dist": "npx electron-builder"
    },
    "build": {
        "appId": "com.carly.app",
        "productName": "Carly",
        "electronVersion": "33.2.1",
        "npmRebuild": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "icon.png",
            {
                "from": "../client/dist",
                "to": "client/dist",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": "dir"
        },
        "mac": {
            "target": "dmg"
        }
    },
    "devDependencies": {
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.98.0",
        "node-cron": "^4.2.1"
    }
}
